# cacheblend.env.local — this machine's settings and secrets.
#
#   cp cacheblend.env.local.example cacheblend.env.local
#
# Gitignored. Anything set here overrides cacheblend.env and profiles/momento.env.

# --- secrets ---
# TM_API_KEY=tm_...                    # from the Tensormesh team (setup.sh asks)
# VALKEY_PASSWORD=...

# --- this machine ---
# DATA_DIR=/mnt/nvme0/momento          # local disk for the model weights
# HOST_GPUS=0,1                        # WORKERS x GPUS_PER_WORKER devices
# VALKEY_NODES=10.0.1.20:6379          # Momento's Valkey Large Object endpoint(s)
# VALKEY_CLUSTER=1

# --- weights you already have (skips the download) ---
# MODEL_HOST_DIR=/models/Qwen3-Coder-30B-A3B-Instruct

# --- one GPU on this host (the profile runs two workers) ---
# WORKERS=1
# HOST_GPUS=0
# --- Valkey over EFA (profiles/momento.env defaults to tcp; README, "Status") ---
# VALKEY_TRANSPORT=rdma
# VALKEY_RDMA_INTERFACE=rdmap71s0-rdm,rdmap72s0-rdm   # fi_info -p efa; VALKEY_WORKERS a multiple
# EFA_MAX_MR_GB=384                    # this card's max_mr_size (preflight reads ibv_devinfo)
# VALKEY_TRANSPORT=blob-tcp            # hosts without EFA, sharing the same objects
# --- coordinator (fleet-wide CacheBlend lookup) ---
# COORDINATOR_URL=http://10.0.1.10:9300
