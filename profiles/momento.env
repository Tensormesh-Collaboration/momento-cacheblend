# =============================================================================
# profiles/momento.env — Momento x Tensormesh: CacheBlend + Valkey Large Object.
#
# Loaded on top of cacheblend.env (CB_PROFILE=momento); cacheblend.env.local
# still overrides anything here. Put machine-specific values (DATA_DIR,
# HOST_GPUS, VALKEY_NODES) and secrets (TM_API_KEY, VALKEY_PASSWORD) in .local.
# =============================================================================

# Two workers on one host, one GPU each: agents that move between them must
# find their KV in Valkey. Qwen3-Coder-30B-A3B in bf16 is ~61 GB of weights:
# on 80 GB GPUs use GPUS_PER_WORKER=2, or H200s.
WORKERS=2
GPUS_PER_WORKER=1

# Valkey over TCP by default: it works against any Valkey 8 server and is the
# tested path (README, "Status"). The target for the blog is Valkey
# Large Object over RDMA/EFA (v0.5.8rc1), untested so far:
#   VALKEY_TRANSPORT=rdma    needs EFA, libfabric >= 2.4 on the host, and the
#                            valkey-large-object module on the servers
#   VALKEY_TRANSPORT=blob-tcp  the same objects over TCP, for hosts without EFA
# Each RDMA client registers the whole L1 arena: VALKEY_WORKERS x L1_SIZE_GB
# must stay under the card's registered-memory cap (4 x 16 = 64 GiB; preflight
# reads the cap from ibv_devinfo).
L2_BACKEND=valkey
VALKEY_TRANSPORT=tcp
VALKEY_WORKERS=4

# L1 per worker, the capacity axis (docs/design.md, "L1 sizing"). LMCache evicts
# once L1 is fuller than EVICTION_WATERMARK and allocates each request's chunks
# in one batch, so what stays free must hold the largest prompt: at 16 GiB and
# 0.5, L1 caches about 6.4-8 GiB and keeps 8 GiB free (any 64K-token prompt is
# 6 GiB). This is the headline setting: below the swarms' working set, so C and
# D spill to Valkey and A and B recompute. Sweep it with scripts/sweep.sh --l1.
L1_SIZE_GB=16
EVICTION_WATERMARK=0.5

# For an FP8 checkpoint (e.g. Qwen3-Coder-30B-A3B-Instruct-FP8), the plugin's
# fp8-MoE cards also set VLLM_USE_FLASHINFER_MOE_FP8=0 (pass it in
# DOCKER_EXTRA_ARGS as -e VLLM_USE_FLASHINFER_MOE_FP8=0).
