# =============================================================================
# profiles/momento.env — Momento x Tensormesh: CacheBlend + Valkey Large Object.
#
# Loaded on top of cacheblend.env (CB_PROFILE=momento); cacheblend.env.local
# still overrides anything here. Put machine-specific values (DATA_DIR,
# HOST_GPUS, VALKEY_NODES) and secrets (TM_API_KEY, VALKEY_PASSWORD) in .local.
# =============================================================================

# Two workers on one host, one GPU each: agents that move between them must
# find their KV in Valkey. Qwen3-Coder-30B-A3B in bf16 is ~61 GB of weights:
# on 80 GB GPUs use GPUS_PER_WORKER=2, or H200s.
WORKERS=2
GPUS_PER_WORKER=1

# Valkey Large Object over EFA (v0.5.8rc1). Each RDMA client registers the
# whole L1 arena, so VALKEY_WORKERS x L1_SIZE_GB must stay under the card's
# registered-memory cap: 4 x 22 GiB = 88 GiB leaves headroom under a 96 GiB cap (g6). On hosts with
# a larger cap (preflight reads it from ibv_devinfo) raise either.
# Hosts without EFA: VALKEY_TRANSPORT=blob-tcp shares the same objects.
L2_BACKEND=valkey
VALKEY_TRANSPORT=rdma
VALKEY_WORKERS=4
L1_SIZE_GB=22
# 22 GiB at the default 0.8 watermark leaves 4.4 GiB free, less than one
# 64K-token prompt (6 GiB): evict from 70% so 6.6 GiB stays free.
EVICTION_WATERMARK=0.7
L2_PREFETCH_POLICY=retain
L2_PREFETCH_MAX_IN_FLIGHT=32

# For an FP8 checkpoint (e.g. Qwen3-Coder-30B-A3B-Instruct-FP8), the plugin's
# fp8-MoE cards also set VLLM_USE_FLASHINFER_MOE_FP8=0 (pass it in
# DOCKER_EXTRA_ARGS as -e VLLM_USE_FLASHINFER_MOE_FP8=0).
