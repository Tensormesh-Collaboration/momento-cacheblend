# =============================================================================
# cacheblend.env — every setting for the Momento x Tensormesh swarm benchmark.
#
#   Edit values here, or better, put your overrides in cacheblend.env.local
#   (gitignored). Precedence: shell environment > cacheblend.env.local >
#   profiles/$CB_PROFILE.env > this.
#   Secrets (TM_API_KEY, HF_TOKEN, VALKEY_PASSWORD) belong ONLY in
#   cacheblend.env.local — ./setup.sh asks for the first two and writes them there.
#
#   Plumbing (setup, plugin staging, one-container launch) comes from
#   netapp-cacheblend; what is new here is Valkey as L2, several workers per
#   host, the optional coordinator, and the swarm workload in swarm/.
# =============================================================================


# --- Profile -------------------------------------------------------------------
CB_PROFILE=momento


# --- Access ------------------------------------------------------------------
TM_API_KEY=                # tm_..., from the Tensormesh team: pulls the CacheBlend plugin image
HF_TOKEN=                  # only for gated models (Qwen3-Coder is not gated)


# --- Versions (engine and plugin MUST be the same release) ---------------------
# v0.5.8rc1 (Nov 13, 2026) is the first release with everything config D needs:
#   - the Valkey adapter's "rdma" transport (LMCache #5556) and "blob-tcp" (#6400),
#     RDMA workers spread over several EFA cards (#6293)
#   - fleet-wide CacheBlend lookup through the coordinator (--enable-blend-lookup)
# and cacheblend-plugin v0.5.8rc1 matches it. The engine image is a multi-arch
# manifest (amd64 + arm64), so the tag needs no -amd64 suffix this time.
# Fallback: TM_VERSION=v0.5.6rc4 ENGINE_TAG=v0.5.6rc4-amd64 (Valkey over TCP only).
TM_VERSION=v0.5.8rc1
ENGINE_TAG=v0.5.8rc1
ENGINE_IMAGE=lmcache/vllm-openai:${ENGINE_TAG}
REGISTRY=artifacts.tensormesh.ai
PLUGIN_IMAGE=${REGISTRY}/tensormesh-production/images/cacheblend-plugin:${TM_VERSION}


# --- Model -------------------------------------------------------------------
HF_REPO=Qwen/Qwen3-Coder-30B-A3B-Instruct
SERVED_NAME=qwen3-coder-30b
MODEL_DISK_GB=62
# MODEL_HOST_DIR=/path/to/Qwen3-Coder-30B-A3B-Instruct   # skip the download
MODEL_CONTAINER_PATH=/models/model
MODEL=/models/model


# --- Workers and GPUs ----------------------------------------------------------
# Each worker is one container (vLLM + LMCache server) on its own GPUs, with its
# own L1. Several workers on one host share nothing but the host, so an agent
# moving between them must find its KV in Valkey (or recompute it).
#   WORKERS=2 GPUS_PER_WORKER=1 HOST_GPUS=0,1  -> worker 0 on GPU 0, worker 1 on GPU 1
# Worker i serves vLLM on VLLM_PORT+i and LMCache's admin API on LMCACHE_HTTP_PORT+i.
# Workers on other hosts: run the same kit there with WORKER_BASE=<first index>.
WORKERS=1
GPUS_PER_WORKER=1
WORKER_BASE=0
HOST_GPUS=all
TP_SIZE=auto               # auto = GPUS_PER_WORKER


# --- vLLM ------------------------------------------------------------------------
MAX_MODEL_LEN=65536        # SWE-smith replays reach ~50K tokens with an 8K harness prompt
MAX_NUM_SEQS=16
GPU_MEM_UTIL=0.90
VLLM_PORT=8000
# --enable-prompt-tokens-details: usage reports cached_tokens (GPU prefix hits).
VLLM_EXTRA_ARGS="--enable-prompt-tokens-details"
# CacheBlend's engine flags (cacheblend-plugin v0.5.8rc1, docs/design.md "Engine flags"):
# chunked prefill off (asserted) and either decode-only CUDA graphs
#   --compilation-config '{"mode":0,"cudagraph_mode":"FULL_DECODE_ONLY"}'
# (recommended: decode replays graphs, prefill/blend stays eager) or
# --enforce-eager. The plugin now picks the CUSTOM attention backend, block
# size 64, and turns off vLLM's extensible KV cache by itself.
CB_DECODE_CUDAGRAPH=1      # 1 = FULL_DECODE_ONLY graphs; 0 = --enforce-eager
# vLLM's GPU prefix cache (APC). Off in every leg, so LMCache does all KV reuse
# and the four legs measure exactly its tiers (docs/design.md, "Methodology").
# On an H200 the GPU cache holds ~680K tokens of Qwen3-Coder-30B KV, more than
# L1: with it on, vLLM served the repeats itself and LMCache served 0% of prompt
# tokens in a first GPU run (74% with it off). 1 = on; CacheBlend coexists with
# it as of plugin v0.5.8rc1 (byte-identical to APC-off on dense models only).
ENABLE_APC=0
# 1 = run the prefix-reuse legs (CACHE_MODE=offload) with CacheBlend's engine
# flags above, so hit rates compare like for like. 0 = vLLM production
# defaults (full CUDA graphs, chunked prefill): use for goodput, and label it.
FLAG_MATCHED=1


# --- Storage -----------------------------------------------------------------
DATA_DIR=/mnt/nvme0/momento   # model weights and download cache (and fs L2, if used)


# --- L1: host-memory (DRAM) cache, per worker ----------------------------------
L1_SIZE_GB=64
# Must divide the KV chunk size, or every chunk is padded up to the alignment.
# Qwen3-Coder-30B-A3B is 96 KiB per token: 24 MiB per 256-token chunk, 12 MiB at
# 128, 6 MiB at 64. 16 MiB would pad a 24 MiB chunk to 32 MiB (a third of L1
# wasted); 2 MiB divides every chunk size the sweep uses.
L1_ALIGN_BYTES=2097152
L1_INIT_SIZE_GB=
# LMCache evicts from L1 in a background loop, once a second, and only when L1
# is fuller than EVICTION_WATERMARK; it then frees EVICTION_RATIO of it. A
# request's chunks are allocated all at once: when they do not fit in what is
# free, none of them is stored or read back, and nothing is evicted to make
# room (on dev-2, a 2 GiB L1 stuck at 68% stored nothing for a whole leg). So
# (1 - EVICTION_WATERMARK) x L1_SIZE_GB must hold the largest prompt
# (MAX_REQUEST_TOKENS x 96 KiB for Qwen3-Coder-30B; validate_config checks it),
# and L1 effectively holds about EVICTION_WATERMARK x L1_SIZE_GB.
EVICTION_WATERMARK=0.8
EVICTION_RATIO=0.2
MAX_REQUEST_TOKENS=        # empty = MAX_MODEL_LEN; the schedule's largest prompt is enough


# --- L2 ----------------------------------------------------------------------------
# none    L1 only ("local CPU offload")
# valkey  shared Valkey (Momento's Valkey Large Object deployment)
# fs      files under $DATA_DIR/lmcache-l2 (local testing only)
L2_BACKEND=valkey
L2_STORE_POLICY=default    # default = write through to L2, keep in L1
L2_PREFETCH_POLICY=retain  # keep chunks read back from L2 in L1
L2_PREFETCH_MAX_IN_FLIGHT=32

# Valkey adapter (LMCache "valkey" L2 adapter, valkey-glide-sync client)
VALKEY_NODES=127.0.0.1:6379      # host:port[,host:port...]
VALKEY_CLUSTER=0                 # 1 = Valkey Cluster (GlideClusterClient)
VALKEY_TLS=0
VALKEY_USERNAME=
VALKEY_PASSWORD=                 # secret: set in cacheblend.env.local
VALKEY_KEY_PREFIX=momento-bench  # no '@'
# glide clients per LMCache server: the I/O concurrency. With RDMA each client
# registers the WHOLE L1 arena, so VALKEY_WORKERS x L1_SIZE_GB must fit the EFA
# card's registered-memory cap (EFA_MAX_MR_GB below; validate_config checks).
VALKEY_WORKERS=16
VALKEY_REQUEST_TIMEOUT=5.0
VALKEY_TTL_S=                    # empty = no expiry (Valkey's maxmemory policy evicts)
# tcp       plain SET/GET strings (valkey-glide-sync >= 2.3.0)
# rdma      BLOB.RDMA_SET/GET into and out of L1 over EFA: needs the
#           valkey-large-object module, valkey-glide-sync >= 2.6.0 and
#           libfabric >= 2.4 (the EFA installer's, mounted from EFA_HOST_DIR)
# blob-tcp  the same module objects as rdma over the RESP connection, so hosts
#           without EFA can share one cache with RDMA hosts. Not faster than tcp.
# tcp keys and module keys cannot share a key prefix; run_leg.sh wipes the
# prefix before every leg anyway.
VALKEY_TRANSPORT=tcp
VALKEY_RDMA_PROVIDER=efa-direct  # rdma only: efa-direct | tcp (libfabric software provider, no hardware)
# rdma only: fabric domain(s) as `fi_info -p efa` lists them, comma-separated
# (e.g. rdmap71s0-rdm,rdmap72s0-rdm). With several, workers are spread over the
# cards round-robin: make VALKEY_WORKERS a multiple. Empty = provider's choice.
VALKEY_RDMA_INTERFACE=
EFA_HOST_DIR=/opt/amazon/efa     # rdma only: host libfabric, mounted read-only into each worker
EFA_MAX_MR_GB=96                 # rdma only: EFA max_mr_size (ibv_devinfo -v): 96 GiB on g6, 384 on c8gn
# 1 = pip install valkey-glide-sync inside the container if the image lacks it
# (>= 2.6.0 for rdma, >= 2.3.0 otherwise; needs network from the container).
# 0 = fail with instructions.
VALKEY_PIP_INSTALL=1

# fs L2 (only when L2_BACKEND=fs)
L2_MAX_GB=0
L2_EVICTION=LRU
L2_MIN_FREE_GB=450
L2_WORKERS=32
L2_ODIRECT=0
L2_READ_AHEAD=8192
L2_REQUIRE_NETFS=0


# --- Coordinator (fleet-wide CacheBlend lookup; in v0.5.8rc1) -----------------------
# Empty = none: each worker's CacheBlend matches only chunks it stored itself.
# Set to http://<host>:9300 after ./scripts/coordinator.sh start on that host.
COORDINATOR_URL=
COORDINATOR_PORT=9300


# --- CacheBlend --------------------------------------------------------------
CACHE_MODE=blend           # blend | offload (prefix reuse only); configs/*.env set it per leg
# Tokens per KV chunk: the unit LMCache stores and CacheBlend matches. 256 is the
# validated setting and the default for every measured leg. 128 and 64 are for
# the chunk-size sweep (scripts/chunk_smoke.sh, simulate --chunk-size): finer
# chunks recover the partial chunks at the edges of a reused span, at the cost of
# 2x/4x more stored objects and shorter blended spans (an unmeasured quality risk).
CHUNK_SIZE=256
# No plugin model card for Qwen3-Coder-30B-A3B (Qwen3MoeForCausalLM) yet. The
# v0.5.8rc1 cards use 1 (Qwen3-8B), 2 (gpt-oss-20b, also the plugin default)
# and 3 (Qwen3.5-35B-A3B draft). 3 is a guess for a 48-layer model: sweep 1-3
# with scripts/smoke_cb.py and bench quality before the measured runs.
CB_CHECK_LAYER=3
CB_RECOMP_RATIO=0.15
LMCACHE_MAX_WORKERS=auto   # = TP size
MQ_TIMEOUT=660


# --- Ports ---------------------------------------------------------------------
LMCACHE_PORT=5555          # cache server <-> vLLM, inside each container
LMCACHE_HTTP_PORT=8080     # LMCache admin API + /metrics, host loopback only


# --- Benchmark (./run_leg.sh) -----------------------------------------------------
SCHEDULE=                  # schedule directory from python -m swarm.generate
TIME_SCALE=1.0             # multiply tool gaps (and start offsets)
IDLE_SCALE=1.0             # multiply idle gaps
TTFT_TARGET=2.0            # seconds, for goodput
